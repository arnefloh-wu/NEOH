SV_6XdtUhqad8e0NUO","Element":"SCO","PrimaryAttribute":"Scoring","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"ScoringCategories":[],"ScoringCategoryGroups":[],"ScoringSummaryCategory":null,"ScoringSummaryAfterQuestions":0,"ScoringSummaryAfterSurvey":0,"DefaultScoringCategory":null,"AutoScoringCategory":null}},{"SurveyID":"SV_6XdtUhqad8e0NUO","Element":"SO","PrimaryAttribute":"Survey Options","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"BackButton":"false","SaveAndContinue":"true","SurveyProtection":"PublicSurvey","BallotBoxStuffingPrevention":"false","NoIndex":"Yes","SecureResponseFiles":"true","SurveyExpiration":"None","SurveyTermination":"DefaultMessage","Header":"","Footer":"","ProgressBarDisplay":"None","PartialData":"+1 week","ValidationMessage":"","PreviousButton":"","NextButton":"","SurveyTitle":"Qualtrics Umfrage | Qualtrics Experience Management","SkinLibrary":"wumarketing","SkinType":"templated","Skin":{"brandingId":"2498303835","templateId":"*base","overrides":null},"NewScoring":1,"SurveyMetaDescription":"Die st\u00e4rkste, einfachste und vertrauensw\u00fcrdigste M\u00f6glichkeit zur Sammlung von Erfahrungsdaten. Beginnen Sie Ihre Reise mit Experience Management und testen Sie noch heute ein kostenloses Konto."}},{"SurveyID":"SV_6XdtUhqad8e0NUO","Element":"SQ","PrimaryAttribute":"QID1","SecondaryAttribute":"Liebe Umfrageteilnehmer:innen, Vielen Dank, dass Sie an unserer Studie teilnehmen. Im Rahmen eine...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Liebe Umfrageteilnehmer:innen,<\/strong><br>\n<br>\nVielen Dank, dass Sie an unserer Studie teilnehmen. Im Rahmen eines Forschungsprojekts der WU Wien untersuchen wir, wie \u00f6sterreichische Konsument:innen Schokoladen- und Snackmarken wahrnehmen. Ihre Antworten helfen uns, aktuelle Trends im S\u00fc\u00dfwarenmarkt besser zu verstehen.<br>\n<br>\nWas erwartet Sie?<br>\nFragen zu Ihrer Markenwahrnehmung, Ihren Mediengewohnheiten und Ihrem Kaufverhalten bei Schokoladen- und Snackriegeln.<br>\n<br>\nDauer: ca. 10\u201313 Minuten<br>\n<br>\nDatenschutz: Ihre Antworten werden anonym erfasst und ausschlie\u00dflich f\u00fcr wissenschaftliche Zwecke verwendet. Eine Zuordnung zu Ihrer Person ist nicht m\u00f6glich. Bitte beantworten Sie die Fragen spontan \u2014 es gibt keine richtigen oder falschen Antworten.<br><br>Mit besten Gr\u00fc\u00dfen,<br><br>Dr. Arne Floh<br>arne.floh@wu.ac.at<br>","DefaultChoices":false,"DataExportTag":"einleitung","QuestionID":"QID1","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Liebe Umfrageteilnehmer:innen, Vielen Dank, dass Sie an unserer Studie teilnehmen. Im Rahmen eine...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_6XdtUhqad8e0NUO","Element":"SQ","PrimaryAttribute":"QID10","SecondaryAttribute":"In welchen der folgenden Kan\u00e4le haben Sie im letzten Monat von NEOH geh\u00f6rt oder NEOH gesehen? Meh.","TertiaryAttribute":null,"Payload":{"QuestionText":"In welchen der folgenden Kan\u00e4le haben Sie im letzten Monat von NEOH geh\u00f6rt oder NEOH gesehen? Mehrfachnennungen m\u00f6glich.","DataExportTag":"kanal","QuestionID":"QID10","QuestionType":"MC","Selector":"MAVR","SubSelector":"TX","QuestionDescription":"In welchen der folgenden Kan\u00e4le haben Sie im letzten Monat von NEOH geh\u00f6rt oder NEOH gesehen? Meh...","Choices":{"1":{"Display":"TV-Werbung"},"2":{"Display":"Printwerbung (Zeitungen\/Zeitschriften)"},"3":{"Display":"Werbung auf Websites"},"4":{"Display":"Instagram\/Facebook"},"5":{"Display":"YouTube"},"6":{"Display":"TikTok"},"7":{"Display":"Influencer-\/Content-Creator-Empfehlungen"},"8":{"Display":"Supermarkt (Regal, Display)"},"9":{"Display":"Mundpropaganda (Freunde, Familie, Kollegen)"},"10":{"Display":"Au\u00dfenwerbung (Plakate, \u00f6ffentlicher Nahver